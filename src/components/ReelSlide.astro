---
/**
 * ReelSlide — Individual quote slide for the vertical reel.
 *
 * Artistic Typography Engine:
 * - Font: 'Playfair Display' high-contrast editorial serif
 * - Adaptive space utilization: Font size scales fluidly based on quote length and viewport dimensions
 * - Perfect vertical & horizontal centering for the quote
 * - Bottom-docked metadata (Author, Category, Mood, Tags)
 * - Symmetrical clamp padding guarantees zero overlap with right rail buttons
 */
import { getMediaForQuote, getAudioForMood, moodMeta } from '../data/mediaRegistry';
import type { Mood } from '../data/mediaRegistry';
import { slugifyQuote } from '../utils/slug';

interface Props {
  id: string;
  content: string;
  author: string;
  authorSlug: string;
  category: string;
  categorySlug: string;
  mood: Mood;
  tags: string[];
  index: number;
  isStreamContinuation?: boolean;
  isTopicMatch?: boolean;
  sourceWork?: string;
  story?: string;
  explanation?: string;
  practicalInsight?: string;
  reflectionPrompt?: string;
}

const {
  id,
  content,
  author,
  authorSlug,
  category,
  categorySlug,
  mood,
  tags,
  index,
  isStreamContinuation = false,
  isTopicMatch = true,
  sourceWork,
  story,
  explanation,
  practicalInsight,
  reflectionPrompt,
} = Astro.props;

const media = getMediaForQuote(id, mood);
const audioSrc = getAudioForMood(mood);
const moodInfo = moodMeta[mood];
const BASE = '/wisdom';
const quoteSlug = slugifyQuote(content);
const quoteExplanation = explanation || story || '';

// Length-adaptive typography sizing: utilizes screen space dynamically
const len = content.length;
let quoteSizeStyle = '';
let maxContainerClass = '';

if (len < 55) {
  quoteSizeStyle = 'font-size: clamp(2.2rem, 5.5vw, 4.2rem); line-height: 1.28; letter-spacing: 0.01em; max-width: 900px;';
  maxContainerClass = 'max-w-3xl';
} else if (len < 110) {
  quoteSizeStyle = 'font-size: clamp(1.75rem, 4.2vw, 3.1rem); line-height: 1.35; letter-spacing: 0.01em; max-width: 950px;';
  maxContainerClass = 'max-w-4xl';
} else if (len < 180) {
  quoteSizeStyle = 'font-size: clamp(1.4rem, 3.2vw, 2.4rem); line-height: 1.42; letter-spacing: 0.01em; max-width: 1000px;';
  maxContainerClass = 'max-w-4xl';
} else {
  quoteSizeStyle = 'font-size: clamp(1.2rem, 2.6vw, 1.95rem); line-height: 1.48; letter-spacing: 0.01em; max-width: 1050px;';
  maxContainerClass = 'max-w-5xl';
}
---
<section
  id={`slide-${id}`}
  class="reel-slide relative z-10 w-full h-[100dvh] flex flex-col justify-between overflow-hidden select-none"
  data-quote-id={id}
  data-quote-slug={quoteSlug}
  data-content={content}
  data-author={author}
  data-author-slug={authorSlug}
  data-gradient-class={media.gradient}
  data-mood={mood}
  data-mood-label={moodInfo.label}
  data-mood-emoji={moodInfo.emoji}
  data-category={category}
  data-category-slug={categorySlug}
  data-tags={JSON.stringify(tags)}
  data-audio-src={audioSrc}
  data-index={index}
  data-topic-match={isTopicMatch ? 'true' : 'false'}
  data-source-work={sourceWork || ''}
  data-explanation={quoteExplanation}
  data-practical-insight={practicalInsight || ''}
  data-reflection-prompt={reflectionPrompt || ''}
>
  <!-- Double-tap detection zone across entire slide -->
  <div
    class="absolute inset-0 z-10 cursor-pointer"
    data-doubletap-zone={id}
  ></div>

  <!-- Top spacer to balance the fixed header bar and top tags dock -->
  <div
    class="h-16 sm:h-20 w-full shrink-0 pointer-events-none"
    style="min-height: calc(max(env(safe-area-inset-top, 0px), 8px) + 60px);"
    aria-hidden="true"
  ></div>

  {isStreamContinuation && (
    <div
      class="continuation-banner pointer-events-none absolute top-28 sm:top-32 z-30 left-1/2 -translate-x-1/2 flex items-center gap-2 glass px-4.5 py-2 rounded-full border border-white/20 text-[11px] font-medium text-white/90 shadow-xl shadow-black/40 select-none tracking-wider uppercase leading-normal"
      style="top: calc(max(env(safe-area-inset-top, 0px), 16px) + 94px);"
    >
      <span class="text-amber-300">✦</span>
      <span>More Wisdom Ahead</span>
    </div>
  )}

  <!-- ── CENTER OF SCREEN: ONLY THE QUOTE ── -->
  <!-- Wide, spacious canvas — action rail is positioned down in the bottom-right corner -->
  <div
    class="relative z-20 flex-1 flex flex-col items-center justify-center pointer-events-none text-center w-full my-auto"
    style="padding-right: clamp(1.75rem, 6vw, 4.5rem); padding-left: clamp(1.75rem, 6vw, 4.5rem);"
  >
    <div class={`${maxContainerClass} w-full flex flex-col items-center justify-center`}>
      <!-- Artistic Decorative Quote Mark -->
      <div class="text-4xl sm:text-5xl md:text-6xl leading-none text-white/30 font-serif select-none mb-3 font-display">
        &ldquo;
      </div>

      <!-- The Centered Artistic Quote Text -->
      <p
        class="font-display font-normal tracking-[-0.01em] text-white text-shadow-artistic select-none quote-text"
        style={`${quoteSizeStyle} font-family: var(--font-display);`}
      >
        {content}
      </p>

      <!-- Author Attribution & Delve Pill -->
      <div class="mt-7 sm:mt-9 select-none flex flex-col items-center gap-2.5">
        <a
          href={`${BASE}/author/${authorSlug}/`}
          class="pointer-events-auto inline-flex items-center flex-wrap justify-center gap-1.5 text-base sm:text-lg md:text-xl font-normal text-white/80 hover:text-white transition-all duration-200 group cursor-pointer"
          style="font-family: var(--font-editorial); font-style: italic; letter-spacing: 0.02em;"
          title={`More quotes by ${author}`}
        >
          <span class="text-white/40 not-italic font-light select-none">&mdash;</span>
          <span class="author-name-text group-hover:underline underline-offset-4 decoration-white/40 transition-all">{author}</span>
          {sourceWork && (
            <span class="source-work-citation text-white/45 text-sm sm:text-base not-italic font-sans font-light tracking-normal">
              , <em class="italic text-white/65">{sourceWork}</em>
            </span>
          )}
        </a>

        {quoteExplanation && (
          <button
            type="button"
            class="pill pill-lg delve-pill-btn pointer-events-auto mt-1 inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white/[0.08] hover:bg-white/[0.16] border border-white/15 hover:border-amber-400/40 text-xs sm:text-[13px] text-amber-200/90 hover:text-amber-100 font-sans tracking-wide transition-all duration-200 active:scale-95 shadow-md group cursor-pointer backdrop-blur-md"
            data-quote-id={id}
            title="Delve into the meaning, philosophy, and practical insight of this quote"
          >
            <span class="text-amber-300 text-xs group-hover:scale-110 transition-transform animate-pulse-soft">✦</span>
            <span class="font-medium">Delve</span>
            <svg class="w-3.5 h-3.5 text-white/40 group-hover:text-white/80 group-hover:translate-x-0.5 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        )}
      </div>
    </div>
  </div>

  <!-- ── BOTTOM OF SCREEN: CLEARANCE SPACER ── -->
  <!-- Reserves vertical space matching the fixed bottom metadata dock (Category & Mood) -->
  <div
    class="relative z-20 shrink-0 pb-[max(env(safe-area-inset-bottom,12px),16px)] pt-2 pointer-events-none"
    style="padding-right: clamp(4.5rem, 12vw, 6.5rem); padding-left: clamp(1.25rem, 4vw, 2.5rem);"
    aria-hidden="true"
  >
    <div class="h-9 sm:h-10 w-full max-w-md pointer-events-none"></div>
  </div>

  <!-- Accessible Screen Reader & SEO Metadata -->
  <div class="sr-only">
    <span>Category: {category}</span>
    <span>Mood: {moodInfo.label}</span>
    <span>Tags: {tags.map(t => `#${t}`).join(' ')}</span>
  </div>
</section>
