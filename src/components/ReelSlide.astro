---
/**
 * ReelSlide — Individual quote slide for the vertical reel.
 *
 * Artistic Typography Engine:
 * - Font: Dynamic font configured per language (Devanagari serif for Hindi, Playfair for English)
 * - Adaptive space utilization: Font size scales fluidly based on quote length and viewport dimensions
 * - Perfect vertical & horizontal centering for the quote
 * - Bottom-docked metadata (Author, Category, Mood, Tags)
 * - Symmetrical clamp padding guarantees zero overlap with right rail buttons
 */
import { getMediaForQuote, getAudioForMood, getLocalizedMoodMeta } from '../data/mediaRegistry';
import type { Mood } from '../data/mediaRegistry';
import { slugifyQuote } from '../utils/slug';
import { resolveThemeConfig } from '../config/themeConfig';
import type { Translations, DeepPartial } from '../i18n/types';

interface Props {
  id: string;
  content: string;
  author: string;
  authorSlug: string;
  category: string;
  categorySlug: string;
  mood: Mood;
  tags: string[];
  index: number;
  isStreamContinuation?: boolean;
  isTopicMatch?: boolean;
  sourceWork?: string;
  story?: string;
  explanation?: string;
  practicalInsight?: string;
  reflectionPrompt?: string;
  lang?: string;
  base?: string;
  translations?: DeepPartial<Translations>;
}

const {
  id,
  content,
  author,
  authorSlug,
  category,
  categorySlug,
  mood,
  tags,
  index,
  isStreamContinuation = false,
  isTopicMatch = true,
  sourceWork,
  story,
  explanation,
  practicalInsight,
  reflectionPrompt,
  lang,
  base,
  translations,
} = Astro.props;

const config = resolveThemeConfig({
  language: lang,
  base: base,
  translations: translations,
});

const BASE = config.base;
const t = config.translations;
const media = getMediaForQuote(id, mood);
const audioSrc = getAudioForMood(mood, BASE);
const moodInfo = getLocalizedMoodMeta(mood, config.language);
const quoteSlug = slugifyQuote(content);
const quoteExplanation = explanation || story || '';

// Length-adaptive typography sizing: utilizes screen space dynamically
const len = content.length;
let quoteSizeStyle = '';
let maxContainerClass = '';

if (len < 55) {
  quoteSizeStyle = 'font-size: clamp(2.2rem, 5.5vw, 4.2rem); line-height: 1.32; letter-spacing: 0.01em; max-width: 900px;';
  maxContainerClass = 'max-w-3xl';
} else if (len < 110) {
  quoteSizeStyle = 'font-size: clamp(1.75rem, 4.2vw, 3.1rem); line-height: 1.38; letter-spacing: 0.01em; max-width: 950px;';
  maxContainerClass = 'max-w-4xl';
} else if (len < 180) {
  quoteSizeStyle = 'font-size: clamp(1.4rem, 3.2vw, 2.4rem); line-height: 1.45; letter-spacing: 0.01em; max-width: 1000px;';
  maxContainerClass = 'max-w-4xl';
} else {
  quoteSizeStyle = 'font-size: clamp(1.2rem, 2.6vw, 1.95rem); line-height: 1.5; letter-spacing: 0.01em; max-width: 1050px;';
  maxContainerClass = 'max-w-5xl';
}
---
<section
  id={`slide-${id}`}
  class="reel-slide relative z-10 w-full h-[100dvh] flex flex-col justify-between overflow-hidden select-none"
  data-quote-id={id}
  data-quote-slug={quoteSlug}
  data-content={content}
  data-author={author}
  data-author-slug={authorSlug}
  data-gradient-class={media.gradient}
  data-mood={mood}
  data-mood-label={moodInfo.label}
  data-mood-emoji={moodInfo.emoji}
  data-category={category}
  data-category-slug={categorySlug}
  data-tags={JSON.stringify(tags)}
  data-audio-src={audioSrc}
  data-index={index}
  data-topic-match={isTopicMatch ? 'true' : 'false'}
  data-source-work={sourceWork || ''}
  data-explanation={quoteExplanation}
  data-practical-insight={practicalInsight || ''}
  data-reflection-prompt={reflectionPrompt || ''}
>
  <style is:global>
    @keyframes quoteReveal {
      0% { opacity: 0; filter: blur(12px); transform: translateY(20px) scale(0.95); }
      100% { opacity: 1; filter: blur(0); transform: translateY(0) scale(1); }
    }
    .reel-slide.is-active .quote-text {
      animation: quoteReveal 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }
    .reel-slide:not(.is-active) .quote-text {
      opacity: 0;
    }
    @keyframes heartBurst {
      0% { opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
      15% { opacity: 1; transform: translate(-50%, -50%) scale(1.2) rotate(-5deg); }
      30% { transform: translate(-50%, -50%) scale(1) rotate(5deg); }
      45% { transform: translate(-50%, -50%) scale(1.1) rotate(0deg); }
      80% { opacity: 1; transform: translate(-50%, -50%) scale(1); filter: blur(0); }
      100% { opacity: 0; transform: translate(-50%, -50%) scale(1.5); filter: blur(10px); }
    }
    .heart-burst.animate {
      animation: heartBurst 1s ease-out forwards;
    }
  </style>
  <!-- Double-tap detection zone across entire slide -->
  <div
    class="absolute inset-0 z-10 cursor-pointer"
    data-doubletap-zone={id}
  ></div>

  <!-- Double-tap Heart Burst Element -->
  <div class="heart-burst absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-40 pointer-events-none opacity-0 flex items-center justify-center">
    <svg width="140" height="140" viewBox="0 0 24 24" fill="#ef4444" class="drop-shadow-2xl" style="filter: drop-shadow(0 0 40px rgba(239,68,68,0.8));">
      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
    </svg>
  </div>

  <!-- Top spacer to balance the fixed header bar and top tags dock -->
  <div
    class="h-16 sm:h-20 w-full shrink-0 pointer-events-none"
    style="min-height: calc(max(env(safe-area-inset-top, 0px), 8px) + 60px);"
    aria-hidden="true"
  ></div>

  {isStreamContinuation && (
    <div
      class="continuation-banner pointer-events-none absolute top-28 sm:top-32 z-30 left-1/2 -translate-x-1/2 flex items-center gap-2 glass px-4.5 py-2 rounded-full border border-white/20 text-[11px] font-medium text-white/90 shadow-xl shadow-black/40 select-none tracking-wider uppercase leading-normal"
      style="top: calc(max(env(safe-area-inset-top, 0px), 16px) + 94px);"
    >
      <span class="text-amber-300">✦</span>
      <span>{t.slide.moreAhead}</span>
    </div>
  )}

  <!-- ── CENTER OF SCREEN: ONLY THE QUOTE ── -->
  <!-- Wide, spacious canvas — action rail is positioned down in the bottom-right corner -->
  <div
    class="relative z-20 flex-1 flex flex-col items-center justify-center pointer-events-none text-center w-full my-auto"
    style="padding-right: clamp(1.75rem, 6vw, 4.5rem); padding-left: clamp(1.75rem, 6vw, 4.5rem);"
  >
    <div class={`${maxContainerClass} w-full flex flex-col items-center justify-center quote-content-container`}>
      <!-- Artistic Decorative Quote Mark -->
      <div class="text-4xl sm:text-5xl md:text-6xl leading-none text-white/30 font-serif select-none mb-3 font-display">
        {t.slide.quoteMarkOpen}
      </div>

      <!-- The Centered Artistic Quote Text -->
      <p
        class="font-display font-normal tracking-[-0.01em] text-white text-shadow-artistic select-none quote-text"
        style={`${quoteSizeStyle} font-family: var(--font-display);`}
      >
        {content}
      </p>

      <!-- Author Attribution & Delve Pill -->
      <div class="mt-7 sm:mt-9 select-none flex flex-col items-center gap-2.5">
        <a
          href={`${BASE}/author/${authorSlug}/`}
          class="pointer-events-auto inline-flex items-center flex-wrap justify-center gap-1.5 text-base sm:text-lg md:text-xl font-normal text-white/80 hover:text-white transition-all duration-200 group cursor-pointer"
          style="font-family: var(--font-editorial); letter-spacing: 0.02em;"
          title={t.slide.moreByAuthor.replace('{author}', author)}
        >
          <span class="text-white/40 not-italic font-light select-none">&mdash;</span>
          <span class="author-name-text group-hover:underline underline-offset-4 decoration-white/40 transition-all">{author}</span>
          {sourceWork && (
            <span class="source-work-citation text-white/45 text-sm sm:text-base not-italic font-sans font-light tracking-normal">
              , <em class="italic text-white/65">{sourceWork}</em>
            </span>
          )}
        </a>

        {quoteExplanation && (
          <button
            type="button"
            class="pill pill-lg delve-pill-btn pointer-events-auto mt-1 inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white/[0.08] hover:bg-white/[0.16] border border-white/15 hover:border-amber-400/40 text-xs sm:text-[13px] text-amber-200/90 hover:text-amber-100 font-sans tracking-wide transition-all duration-200 active:scale-95 shadow-md group cursor-pointer backdrop-blur-md"
            data-quote-id={id}
            title={t.slide.delveTitle}
          >
            <span class="text-amber-300 text-xs group-hover:scale-110 transition-transform animate-pulse-soft">✦</span>
            <span class="font-medium">{t.slide.delve}</span>
            <svg class="w-3.5 h-3.5 text-white/40 group-hover:text-white/80 group-hover:translate-x-0.5 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        )}
      </div>
    </div>
  </div>

  <!-- ── BOTTOM OF SCREEN: CLEARANCE SPACER ── -->
  <!-- Reserves vertical space matching the fixed bottom metadata dock (Category & Mood) -->
  <div
    class="relative z-20 shrink-0 pb-[max(env(safe-area-inset-bottom,12px),16px)] pt-2 pointer-events-none"
    style="padding-right: clamp(4.5rem, 12vw, 6.5rem); padding-left: clamp(1.25rem, 4vw, 2.5rem);"
    aria-hidden="true"
  >
    <div class="h-9 sm:h-10 w-full max-w-md pointer-events-none"></div>
  </div>

  <!-- Prominent On-Screen Share CTA (above the clearance spacer, dynamically hidden if overlapping) -->
  <button
    type="button"
    class="on-screen-share-btn absolute bottom-32 sm:bottom-36 left-1/2 -translate-x-1/2 z-30 flex items-center gap-2 px-6 py-3 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 backdrop-blur-md text-white shadow-[0_8px_30px_rgba(0,0,0,0.5)] transition-all duration-300 active:scale-95 cursor-pointer opacity-0 pointer-events-none"
    data-quote-id={id}
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="text-white drop-shadow-md">
      <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
      <polyline points="16 6 12 2 8 6" />
      <line x1="12" y1="2" x2="12" y2="15" />
    </svg>
    <span class="text-sm sm:text-base font-semibold tracking-wide shadow-black/50 drop-shadow-md">Share to Story</span>
  </button>


  <!-- Watermark for organic screenshots -->
  <div class="absolute bottom-[max(env(safe-area-inset-bottom,12px),16px)] left-1/2 -translate-x-1/2 z-20 pointer-events-none opacity-40 flex flex-col items-center gap-1 mix-blend-overlay">
    <span class="text-[10px] uppercase tracking-[0.3em] font-medium text-white/80">{config.base === '/wiz-theme' ? 'wiz-theme' : 'Wisdom'}</span>
  </div>

  <!-- Accessible Screen Reader & SEO Metadata -->
  <div class="sr-only">
    <span>{t.slide.srCategory}: {category}</span>
    <span>{t.slide.srMood}: {moodInfo.label}</span>
    <span>{t.slide.srTags}: {tags.map(t => `#${t}`).join(' ')}</span>
  </div>
</section>

<script>
  // Simple logic to trigger share modal and double-tap heart burst
  if (typeof window !== 'undefined') {
    // Dynamic Share Button Visibility logic
    const updateShareVisibility = () => {
      document.querySelectorAll('.reel-slide').forEach(slide => {
        const container = slide.querySelector('.quote-content-container');
        const shareBtn = slide.querySelector('.on-screen-share-btn');
        if (container && shareBtn) {
          // Hide button if the quote container requires too much vertical space
          if (container.offsetHeight > slide.offsetHeight - 380) {
            shareBtn.style.opacity = '0';
            shareBtn.style.pointerEvents = 'none';
          } else {
            shareBtn.style.opacity = '1';
            shareBtn.style.pointerEvents = 'auto';
          }
        }
      });
    };

    window.addEventListener('resize', updateShareVisibility);
    setTimeout(updateShareVisibility, 50);
    setTimeout(updateShareVisibility, 500);
    // Observe resize of the document for reliable updates
    const resizeObserver = new ResizeObserver(() => updateShareVisibility());
    resizeObserver.observe(document.body);

    document.addEventListener('click', (e) => {
      const target = e.target;
      if (target && target.closest) {
        const shareBtn = target.closest('.on-screen-share-btn');
        if (shareBtn) {
          e.stopPropagation();
          const modal = document.getElementById('share-modal');
          if (modal) {
            modal.classList.remove('hidden');
            modal.style.display = 'flex';
            const slide = shareBtn.closest('.reel-slide');
            if (window.updateShareContext && slide) {
              window.updateShareContext(slide, true);
            }
          }
        }
      }
    });

    // Double tap handling logic
    document.addEventListener('dblclick', (e) => {
      const target = e.target;
      if (target && target.closest) {
        const zone = target.closest('[data-doubletap-zone]');
        if (zone) {
          const slide = zone.closest('.reel-slide');
          if (slide) {
            // Trigger heart burst
            const heartBurst = slide.querySelector('.heart-burst');
            if (heartBurst) {
              heartBurst.classList.remove('animate');
              void heartBurst.offsetWidth; // trigger reflow
              heartBurst.classList.add('animate');
            }
            
            // Trigger like logic if right rail exists
            const likeBtn = document.getElementById('like-btn');
            if (likeBtn) {
              const quoteId = zone.dataset.doubletapZone;
              if (window.likedQuotes && quoteId) {
                if (!window.likedQuotes.has(quoteId)) {
                  likeBtn.click();
                }
              } else {
                likeBtn.click();
              }
            }
          }
        }
      }
    });

    // Also support touch double tap
    let lastTap = 0;
    document.addEventListener('touchend', (e) => {
      const target = e.target;
      if (target && target.closest) {
        const zone = target.closest('[data-doubletap-zone]');
        if (zone) {
          const currentTime = new Date().getTime();
          const tapLength = currentTime - lastTap;
          if (tapLength < 500 && tapLength > 0) {
            e.preventDefault();
            const slide = zone.closest('.reel-slide');
            if (slide) {
              const heartBurst = slide.querySelector('.heart-burst');
              if (heartBurst) {
                heartBurst.classList.remove('animate');
                void heartBurst.offsetWidth; // trigger reflow
                heartBurst.classList.add('animate');
              }
              const likeBtn = document.getElementById('like-btn');
              if (likeBtn) {
                const quoteId = zone.dataset.doubletapZone;
                if (window.likedQuotes && quoteId) {
                  if (!window.likedQuotes.has(quoteId)) {
                    likeBtn.click();
                  }
                } else {
                  likeBtn.click();
                }
              }
            }
          }
          lastTap = currentTime;
        }
      }
    }, { passive: false });
  }
</script>
