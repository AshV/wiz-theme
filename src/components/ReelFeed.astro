        glowGradient: 'radial-gradient(ellipse at 50% 0%, rgba(59, 130, 246, 0.32) 0%, transparent 70%)',
        badgeBg: 'rgba(59, 130, 246, 0.22)',
      },
      romantic: {
        accent: '#f9a8d4',
        accentRgb: '249, 168, 212',
        accentDark: '#ec4899',
        glow: 'rgba(244, 114, 182, 0.55)',
        glowSoft: 'rgba(244, 114, 182, 0.22)',
        border: 'rgba(249, 168, 212, 0.42)',
        modalBg: '#301324',
        headerBg: '#401930',
        glowGradient: 'radial-gradient(ellipse at 50% 0%, rgba(236, 72, 153, 0.32) 0%, transparent 70%)',
        badgeBg: 'rgba(236, 72, 153, 0.22)',
      }
    };

    function applyQuoteThemeToModals(mood, explicitPalette = null) {
      const activePalette = explicitPalette || (window.wisdomBackground && window.wisdomBackground.getCurrentPalette && window.wisdomBackground.getCurrentPalette()) || null;
      const root = document.documentElement;

      if (activePalette && activePalette.colors && activePalette.colors.length > 0) {
        const c0 = activePalette.colors[0];
        const c1 = activePalette.colors[1] || c0;
        const bgMid = activePalette.bgMid || [20, 16, 40];
        const bgTop = activePalette.bgTop || [12, 10, 28];

        root.style.setProperty('--quote-mood', mood || 'reflective');
        root.style.setProperty('--quote-accent', 'rgb(' + c0.join(',') + ')');
        root.style.setProperty('--quote-accent-rgb', c0.join(','));
        root.style.setProperty('--quote-accent-dark', 'rgb(' + c1.join(',') + ')');
        root.style.setProperty('--quote-glow', activePalette.glow1 || 'rgba(168, 85, 247, 0.45)');
        root.style.setProperty('--quote-glow-soft', activePalette.glowCenter || activePalette.glow2 || 'rgba(168, 85, 247, 0.2)');
        root.style.setProperty('--quote-border', 'rgba(' + c0.join(',') + ', 0.35)');
        root.style.setProperty('--quote-modal-bg', 'rgba(' + bgMid.join(',') + ', 0.94)');
        root.style.setProperty('--quote-modal-header-bg', 'rgba(' + bgTop.join(',') + ', 0.95)');
        root.style.setProperty('--quote-modal-glow', '0 0 60px ' + (activePalette.glow1 || 'rgba(168, 85, 247, 0.25)'));
        root.style.setProperty('--quote-badge-bg', 'rgba(' + c0.join(',') + ', 0.18)');
      } else if (mood) {
        const t = MOOD_MODAL_THEMES[mood] || MOOD_MODAL_THEMES.motivational;
        root.style.setProperty('--quote-mood', mood);
        root.style.setProperty('--quote-accent', t.accent);
        root.style.setProperty('--quote-accent-rgb', t.accentRgb);
        root.style.setProperty('--quote-accent-dark', t.accentDark);
        root.style.setProperty('--quote-glow', t.glow);
        root.style.setProperty('--quote-glow-soft', t.glowSoft);
        root.style.setProperty('--quote-border', t.border);
        root.style.setProperty('--quote-modal-bg', t.modalBg);
        root.style.setProperty('--quote-modal-header-bg', t.headerBg);
        root.style.setProperty('--quote-modal-glow', t.glowGradient);
        root.style.setProperty('--quote-badge-bg', t.badgeBg);
      }
    }
    window.applyQuoteThemeToModals = applyQuoteThemeToModals;

    function updateDockPills(slide, immediate = false) {
      if (!slide || !slide.dataset) return;
      const quoteId = slide.dataset.quoteId;
      if (!quoteId) return;
      if (!immediate && quoteId === currentDockQuoteId) return;

      currentDockQuoteId = quoteId;
      const thisToken = ++flipToken;

      const category = slide.dataset.category || 'Wisdom';
      const categorySlug = slide.dataset.categorySlug || 'wisdom';
      const mood = slide.dataset.mood || 'reflective';
      const moodInfo = moodMetaClient[mood] || { label: mood, emoji: '✨' };
      const moodLabel = slide.dataset.moodLabel || moodInfo.label;
      const moodEmoji = slide.dataset.moodEmoji || moodInfo.emoji;

      let tags = [];
      if (slide.dataset.tags) {
        try {
          tags = JSON.parse(slide.dataset.tags);
        } catch {}
      }

      const catPill = document.getElementById('dock-category-pill');
      const moodPill = document.getElementById('dock-mood-pill');
      const moodEmojiSpan = document.getElementById('dock-mood-emoji');
      const moodLabelSpan = document.getElementById('dock-mood-label');
      const tagsContainer = document.getElementById('dock-tags-container');

      const prefersReducedMotion = _reducedMotion && _reducedMotion.matches;

      if (immediate || prefersReducedMotion) {
        if (catPill) {
          catPill.textContent = category;
          catPill.href = `${base}/category/${categorySlug}/`;
        }
        if (moodPill) {
          moodPill.href = `${base}/mood/${mood}/`;
          moodPill.className = `pill pill-lg pointer-events-auto mood-pill-${mood} rounded-full px-4.5 py-2 text-xs font-semibold hover:scale-105 transition-all duration-200 shadow-md shadow-black/20 inline-flex items-center gap-2 whitespace-nowrap shrink-0 leading-normal dock-pill`;
          if (moodEmojiSpan) moodEmojiSpan.textContent = moodEmoji;
          if (moodLabelSpan) moodLabelSpan.textContent = moodLabel;
        }
        if (tagsContainer) {
          tagsContainer.innerHTML = renderDockTagsHtml(tags, false);
        }
        return;
      }

      // ── Sequential/Random Reveal Sequence ──
      const allOldPills = [];
      if (moodPill) allOldPills.push(moodPill);
      if (catPill) allOldPills.push(catPill);
      if (tagsContainer) {
        allOldPills.push(...Array.from(tagsContainer.querySelectorAll('.dock-pill')));
      }

      // 1. Flip out all pills immediately
      allOldPills.forEach(p => {
        p.classList.remove('pill-flipping-in');
        p.style.animationDelay = '0s';
        p.classList.add('pill-flipping-out');
      });

      // 2. Wait for flip-out to finish (200ms), update contents, then flip in randomly
      setTimeout(() => {
        if (thisToken !== flipToken) return;

        // Update contents
        if (moodPill) {
          moodPill.href = `${base}/mood/${mood}/`;
          moodPill.className = `pill pill-lg pointer-events-auto mood-pill-${mood} rounded-full px-4.5 py-2 text-xs font-semibold hover:scale-105 transition-all duration-200 shadow-md shadow-black/20 inline-flex items-center gap-2 whitespace-nowrap shrink-0 leading-normal dock-pill`;
          if (moodEmojiSpan) moodEmojiSpan.textContent = moodEmoji;
          if (moodLabelSpan) moodLabelSpan.textContent = moodLabel;
        }
        if (catPill) {
          catPill.textContent = category;
          catPill.href = `${base}/category/${categorySlug}/`;
        }
        if (tagsContainer) {
          tagsContainer.innerHTML = renderDockTagsHtml(tags, true);
        }

        // Slight tick for DOM to register updates before animating in
        setTimeout(() => {
          if (thisToken !== flipToken) return;
          const allNewPills = [];
          if (moodPill) allNewPills.push(moodPill);
          if (catPill) allNewPills.push(catPill);
          if (tagsContainer) {
            allNewPills.push(...Array.from(tagsContainer.querySelectorAll('.dock-pill')));
          }

          // Shuffle the pills array to randomize the appearance order
          for (let i = allNewPills.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [allNewPills[i], allNewPills[j]] = [allNewPills[j], allNewPills[i]];
          }

          // Apply staggered animation delays (starting around 1.0s to follow Delve which is at 1.0s absolute)
          allNewPills.forEach((p, idx) => {
            p.classList.remove('pill-flipping-out');
            p.style.animationDelay = `${1.0 + (idx * 0.15)}s`;
            p.classList.add('pill-flipping-in');
          });

          // Cleanup classes after longest possible animation finishes
          setTimeout(() => {
            if (thisToken !== flipToken) return;
            allNewPills.forEach(p => {
              p.classList.remove('pill-flipping-in');
              p.style.animationDelay = '';
            });
          }, 1200);
        }, 30);
      }, 200);
    }

    // ── IntersectionObserver for active slide detection ──
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
          const slide = entry.target;
          const quoteId = slide.dataset.quoteId;
          const videoSrc = slide.dataset.videoSrc;
          const gradientClass = slide.dataset.gradientClass;
          const mood = slide.dataset.mood;
          const audioSrc = slide.dataset.audioSrc;

          // Use tracked slides array for active-index check (avoids querySelectorAll)
          const activeIdx = allSlides.indexOf(slide);

          if (activeIdx >= allSlides.length - 4) {
            appendNextBatch();
          }

          // O(1) active-slide swap: remove class from previous, add to new
          if (_activeSlide && _activeSlide !== slide) _activeSlide.classList.remove('is-active');
          _activeSlide = slide;
          slide.classList.add('is-active');

          // Flip dock metadata pills (mood, category, tags) to match newly active slide
          updateDockPills(slide, false);

          // Update the quote ID pill in the header
          updateQuoteIdPill(quoteId);

          // Record as viewed in the last 50 seen quotes history
          recordQuoteSeen(quoteId);

          // Update background animation with quoteId for unique diverse visual personality
          if (window.setBackground) {
            window.setBackground(videoSrc, gradientClass, mood, quoteId);
          }
          applyQuoteThemeToModals(mood);

          // Play peaceful Zen chime once on slide arrival (then complete silence)
          if (window.wisdomAudio && mood) {
            window.wisdomAudio.playOnce(mood);
          }

          const quoteSlug = slide.dataset.quoteSlug;

          // Update URL hash for natural-language quote permalink on subpages (keep master feed clean)
          if (feedType !== 'master') {
            if (quoteSlug) {
              history.replaceState(null, '', `#${quoteSlug}`);
            } else if (quoteId) {
              history.replaceState(null, '', `#${quoteId}`);
            }
          }

          // Update like and dislike button state
          if (window.likedQuotes && window.updateLikeUI) {
            window.updateLikeUI(window.likedQuotes.has(quoteId));
          }
          if (window.dislikedQuotes && window.updateDislikeUI) {
            window.updateDislikeUI(window.dislikedQuotes.has(quoteId));
          }

          // Debounced quote view count for Firebase RTDB
          if (viewDebounceTimer) clearTimeout(viewDebounceTimer);
          viewDebounceTimer = setTimeout(() => {
            if (_activeSlide === slide && window.firebaseStats && typeof window.firebaseStats.recordView === 'function') {
              window.firebaseStats.recordView(quoteId);
            }
          }, 1500);

          // Update header topic text (remove on scroll if topic is deviated in infinite scroll)
          updateHeaderTopicState(slide);

          // Update share context & background prepare 9:16 quote card image
          if (window.updateShareContext) {
            window.updateShareContext(slide);
          }
          if (window.prepareQuoteCardImage) {
            if ('requestIdleCallback' in window) {
              requestIdleCallback(() => window.prepareQuoteCardImage(slide), { timeout: 2500 });
            }
          }
        }
      });
    }, {
      root: container,
      threshold: 0.5,
    });

    // Helper: update header topic visibility when scrolling between matched and continuation quotes
    function updateHeaderTopicState(slide) {
      if (!slide) return;
      const isTopicMatch = slide.dataset.topicMatch !== 'false';
      const headerTitle = document.getElementById('feed-header-title');
      if (headerTitle && feedType !== 'master') {
        if (isTopicMatch) {
          headerTitle.classList.remove('opacity-0', 'pointer-events-none');
          headerTitle.classList.add('opacity-100');
          headerTitle.removeAttribute('aria-hidden');
        } else {
          headerTitle.classList.remove('opacity-100');
          headerTitle.classList.add('opacity-0', 'pointer-events-none');
          headerTitle.setAttribute('aria-hidden', 'true');
        }
      }
    }

    initialSlides.forEach(slide => observer.observe(slide));

    // ── Quote ID Pill controller ──
    function updateQuoteIdPill(quoteId) {
      const label = document.getElementById('quote-id-pill-label');
      if (label && quoteId) {
        label.textContent = `#${quoteId.replace(/^q?0*/i, '') || '0'}`;
      }
    }

    // Initialize first slide (target quote or freshly randomized top quote)
    if (initialSlides.length > 0) {
      if (!targetHash) {
        container.scrollTop = 0;
      }
      const first = initialSlides[0];
      // Set initial active slide without removing from others (they start inactive)
      _activeSlide = first;
      first.classList.add('is-active');
      recordQuoteSeen(first.dataset.quoteId);
      updateHeaderTopicState(first);
      updateDockPills(first, true);
      updateQuoteIdPill(first.dataset.quoteId);

      if (window.setBackground) {
        window.setBackground(first.dataset.videoSrc, first.dataset.gradientClass, first.dataset.mood, first.dataset.quoteId);
      }
      applyQuoteThemeToModals(first.dataset.mood);
      if (window.likedQuotes && window.updateLikeUI) {
        window.updateLikeUI(window.likedQuotes.has(first.dataset.quoteId));
      }
      if (window.dislikedQuotes && window.updateDislikeUI) {
        window.updateDislikeUI(window.dislikedQuotes.has(first.dataset.quoteId));
      }
      if (viewDebounceTimer) clearTimeout(viewDebounceTimer);
      viewDebounceTimer = setTimeout(() => {
        if (_activeSlide === first && window.firebaseStats && typeof window.firebaseStats.recordView === 'function') {
          window.firebaseStats.recordView(first.dataset.quoteId);
        }
      }, 1500);
      if (window.updateShareContext) {
        window.updateShareContext(first);
      }
      if (window.prepareQuoteCardImage) {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(() => window.prepareQuoteCardImage(first), { timeout: 3000 });
        }
      }
      if (window.wisdomAudio && first.dataset.mood) {
        window.wisdomAudio.setMood(first.dataset.mood);
        window.wisdomAudio.playOnce(first.dataset.mood);
      }

      // Sync URL hash with the first quote only if explicit targetHash was requested or on filtered pages
      if (targetHash) {
        history.replaceState(null, '', `#${targetHash}`);
      } else if (feedType !== 'master' && first.dataset.quoteSlug) {
        history.replaceState(null, '', `#${first.dataset.quoteSlug}`);
      }

      // If targetHash requested quote wasn't in initialSlides, dynamically load and jump to it
      if (targetHash && !initialSlides.some(s => s.dataset.quoteId === targetHash || s.dataset.quoteSlug === targetHash || (targetHash.match(/^q?\d+$/i) && parseInt(s.dataset.quoteId.replace(/\D/g, ''), 10) === parseInt(targetHash.replace(/\D/g, ''), 10)))) {
        navigateToQuote(targetHash, null, true);
      }
    }

    // ── In-Feed Quote Navigation ──
    async function navigateToQuote(slugOrId, quotePayload = null, skipCloseModals = false) {
      if (!slugOrId && !quotePayload) return false;

      if (!skipCloseModals && typeof window.__wisdomCloseAllModals === 'function') {
        window.__wisdomCloseAllModals(true);
      }

      const cleanTarget = slugOrId ? decodeURIComponent(slugOrId).replace(/^#/, '').trim() : '';
      const navNumMatch = cleanTarget ? cleanTarget.match(/^q?(\d+)$/i) : null;
      const navNum = navNumMatch ? parseInt(navNumMatch[1], 10) : null;
      const navNormalizedId = navNum ? ('q' + String(navNum).padStart(navNum >= 1000 ? 4 : 3, '0')).toLowerCase() : null;

      let match = allSlides.find(s => {
        if (quotePayload && (s.dataset.quoteId === quotePayload.id || s.dataset.quoteSlug === quotePayload.slug)) return true;
        if (!cleanTarget) return false;
        const id = s.dataset.quoteId;
        const slug = s.dataset.quoteSlug;
        if (slug === cleanTarget || id === cleanTarget || s.id === `slide-${cleanTarget}`) return true;
        if (id && id.toLowerCase() === cleanTarget.toLowerCase()) return true;
        if (slug && slug.toLowerCase() === cleanTarget.toLowerCase()) return true;
        if (navNormalizedId && id && id.toLowerCase() === navNormalizedId) return true;
        if (navNum !== null && id && parseInt(id.replace(/\D/g, ''), 10) === navNum) return true;
        return false;
      });

      // If quote is not yet rendered in the DOM, resolve and dynamically mount it
      if (!match) {
        let targetQuote = quotePayload;

        // 1. Check loadedQuoteList in memory
        if (!targetQuote && (navNum !== null || cleanTarget)) {
          targetQuote = loadedQuoteList.find(q => {
            if (!q) return false;
            const qNum = parseInt(String(q.id).replace(/\D/g, ''), 10);
            if (navNum !== null && qNum === navNum) return true;
            if (navNormalizedId && String(q.id).toLowerCase() === navNormalizedId) return true;
            if (cleanTarget && (String(q.id).toLowerCase() === cleanTarget.toLowerCase() || (q.slug && q.slug.toLowerCase() === cleanTarget.toLowerCase()))) return true;
            return false;
          });
        }

        // 2. Check window.__wisdomQuoteMap in memory
        if (!targetQuote && window.__wisdomQuoteMap) {
          if (navNormalizedId && window.__wisdomQuoteMap[navNormalizedId]) {
            targetQuote = window.__wisdomQuoteMap[navNormalizedId];
          } else {
            targetQuote = Object.values(window.__wisdomQuoteMap).find(q => {
              if (!q) return false;
              const qNum = parseInt(String(q.id).replace(/\D/g, ''), 10);
              if (navNum !== null && qNum === navNum) return true;
              if (cleanTarget && (String(q.id).toLowerCase() === cleanTarget.toLowerCase() || (q.slug && q.slug.toLowerCase() === cleanTarget.toLowerCase()))) return true;
              return false;
            });
          }
        }

        // 3. Resolve target chunk page via the build-time lookup manifest
        if (!targetQuote && (navNum !== null || cleanTarget)) {
          try {
            const lookup = await getQuoteLookup();
            let targetChunkPage = null;

            if (lookup) {
              if (navNum !== null && lookup.chunks && lookup.chunks[navNum]) {
                targetChunkPage = lookup.chunks[navNum];
              } else if (navNormalizedId && lookup.quotes && lookup.quotes[navNormalizedId]) {
                targetChunkPage = lookup.quotes[navNormalizedId];
              } else if (cleanTarget && lookup.slugs && lookup.slugs[cleanTarget.toLowerCase()]) {
                targetChunkPage = lookup.slugs[cleanTarget.toLowerCase()];
              }
            }

            // Fallback to predicted page only if manifest is unreachable
            if (!targetChunkPage && navNum !== null && navNum >= 1) {
              targetChunkPage = Math.floor((navNum - 1) / 200) + 1;
            }

            if (targetChunkPage) {
              const base = window.__wisdomBaseUrl ?? '';
              const res = await fetch(`${base}/api/quotes/chunk-${targetChunkPage}.json`);
              if (res.ok) {
                const data = await res.json();
                if (data && Array.isArray(data.quotes)) {
                  fetchedChunkPages.add(targetChunkPage);
                  loadedQuoteList.push(...data.quotes);
                  targetQuote = data.quotes.find(q => {
                    const qNum = parseInt(String(q.id).replace(/\D/g, ''), 10);
                    return (
                      qNum === navNum ||
                      (navNormalizedId && String(q.id).toLowerCase() === navNormalizedId) ||
                      (cleanTarget && (
                        String(q.id).toLowerCase() === cleanTarget.toLowerCase() ||
                        (q.slug && q.slug.toLowerCase() === cleanTarget.toLowerCase())
                      ))
                    );
                  });
                }
              }
            }
          } catch (e) {
            console.warn('Error resolving quote chunk for navigation:', e);
          }
        }

        // 4. Mount slide dynamically if found
        if (targetQuote) {
          const newSlide = createSlideFromQuote(targetQuote, templateSlide, `jump-${targetQuote.id}`);
          if (_activeSlide && _activeSlide.parentElement === container) {
            _activeSlide.insertAdjacentElement('afterend', newSlide);
            const activeIdx = allSlides.indexOf(_activeSlide);
            if (activeIdx !== -1) {
              allSlides.splice(activeIdx + 1, 0, newSlide);
            } else {
              allSlides.push(newSlide);
            }
          } else {
            container.appendChild(newSlide);
            allSlides.push(newSlide);
          }
          observer.observe(newSlide);
          match = newSlide;
        }
      }

      if (match) {
        const prevSnap = container.style.scrollSnapType;
        container.style.scrollSnapType = 'none';
        container.scrollTop = match.offsetTop;
        container.scrollTo({ top: match.offsetTop, behavior: 'instant' });

        requestAnimationFrame(() => {
          container.scrollTop = match.offsetTop;
          match.scrollIntoView({ behavior: 'instant', block: 'start' });
          requestAnimationFrame(() => {
            container.style.scrollSnapType = prevSnap;
          });
        });

        if (_activeSlide) _activeSlide.classList.remove('is-active');
        _activeSlide = match;
        match.classList.add('is-active');
        recordQuoteSeen(match.dataset.quoteId);
        updateDockPills(match, true);
        updateQuoteIdPill(match.dataset.quoteId);
        if (window.setBackground) {
          window.setBackground(match.dataset.videoSrc, match.dataset.gradientClass, match.dataset.mood, match.dataset.quoteId);
        }
        applyQuoteThemeToModals(match.dataset.mood);
        if (window.wisdomAudio && match.dataset.mood) {
          window.wisdomAudio.playOnce(match.dataset.mood);
        }
        if (window.likedQuotes && window.updateLikeUI) {
          window.updateLikeUI(window.likedQuotes.has(match.dataset.quoteId));
        }
        if (window.dislikedQuotes && window.updateDislikeUI) {
          window.updateDislikeUI(window.dislikedQuotes.has(match.dataset.quoteId));
        }
        if (viewDebounceTimer) clearTimeout(viewDebounceTimer);
        viewDebounceTimer = setTimeout(() => {
          if (_activeSlide === match && window.firebaseStats && typeof window.firebaseStats.recordView === 'function') {
            window.firebaseStats.recordView(match.dataset.quoteId);
          }
        }, 1500);
        if (window.updateShareContext) {
          window.updateShareContext(match);
        }
        updateHeaderTopicState(match);
        if (window.prepareQuoteCardImage) {
          if ('requestIdleCallback' in window) {
            requestIdleCallback(() => window.prepareQuoteCardImage(match), { timeout: 3000 });
          }
        }
        const finalHash = cleanTarget || match.dataset.quoteSlug || match.dataset.quoteId;
        if (finalHash && window.history && window.history.replaceState) {
          history.replaceState(null, '', `#${finalHash}`);
        }
        return true;
      }

      if (window.showToast) {
        window.showToast(`Quote #${navNum || cleanTarget} could not be found`);
      }
      return false;
    }

    // Global hook & live event listeners
    window.__wisdomNavigateToQuote = navigateToQuote;

    window.addEventListener('hashchange', () => {
      if (window.location.hash) {
        const h = window.location.hash.slice(1);
        if (h && !h.startsWith('explore')) {
          navigateToQuote(h, null, true);
        }
      }
    });



    // ── Double-tap to Like ──
    container.onclick = (e) => {
      const zone = e.target.closest('[data-doubletap-zone]');
      if (!zone) return;

      const now = Date.now();
      const zoneId = zone.dataset.doubletapZone;

      if (now - lastTapTime < 380 && lastTapTarget === zoneId) {
        e.preventDefault();
        triggerDoubleTapLike(zoneId);
        lastTapTime = 0;
        lastTapTarget = null;
      } else {
        lastTapTime = now;
        lastTapTarget = zoneId;
      }
    };

    function triggerDoubleTapLike(quoteId) {
      if (window.likedQuotes) {
        if (!window.likedQuotes.has(quoteId)) {
          window.likedQuotes.toggle(quoteId);
          if (window.updateLikeUI) window.updateLikeUI(true);
        }
      }

      // Heart burst animation
      const overlay = document.getElementById('heart-burst-overlay');
      if (overlay) {
        overlay.style.display = 'flex';
        const svg = overlay.querySelector('svg');
        if (svg) {
          svg.style.animation = 'none';
          svg.offsetHeight; // force reflow
          svg.style.animation = 'heart-burst 0.65s var(--ease-spring) forwards';
        }
        setTimeout(() => { overlay.style.display = 'none'; }, 700);
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupReelFeed);
  } else {
    setupReelFeed();
  }
  document.addEventListener('astro:page-load', setupReelFeed);
</script>
