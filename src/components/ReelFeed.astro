        accentRgb: '103, 232, 249',
        accentDark: '#06b6d4',
        glow: 'rgba(34, 211, 238, 0.55)',
        glowSoft: 'rgba(34, 211, 238, 0.22)',
        border: 'rgba(103, 232, 249, 0.42)',
        modalBg: '#102733',
        headerBg: '#163544',
        glowGradient: 'radial-gradient(ellipse at 50% 0%, rgba(6, 182, 212, 0.32) 0%, transparent 70%)',
        badgeBg: 'rgba(6, 182, 212, 0.22)',
      },
      bold: {
        accent: '#fca5a5',
        accentRgb: '252, 165, 165',
        accentDark: '#ef4444',
        glow: 'rgba(244, 63, 94, 0.55)',
        glowSoft: 'rgba(244, 63, 94, 0.22)',
        border: 'rgba(252, 165, 165, 0.42)',
        modalBg: '#2b1016',
        headerBg: '#38161d',
        glowGradient: 'radial-gradient(ellipse at 50% 0%, rgba(239, 68, 68, 0.32) 0%, transparent 70%)',
        badgeBg: 'rgba(239, 68, 68, 0.22)',
      },
      melancholic: {
