        glowSoft: 'rgba(167, 139, 250, 0.22)',
        border: 'rgba(196, 181, 253, 0.42)',
        modalBg: '#201a30',
        headerBg: '#2a2240',
        glowGradient: 'radial-gradient(ellipse at 50% 0%, rgba(139, 92, 246, 0.32) 0%, transparent 70%)',
        badgeBg: 'rgba(139, 92, 246, 0.22)',
      },
      joyful: {
        accent: '#6ee7b7',
        accentRgb: '110, 231, 183',
        accentDark: '#10b981',
        glow: 'rgba(52, 211, 153, 0.55)',
        glowSoft: 'rgba(52, 211, 153, 0.22)',
        border: 'rgba(110, 231, 183, 0.42)',
