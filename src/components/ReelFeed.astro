        accentDark: '#f59e0b',
        glow: 'rgba(245, 158, 11, 0.55)',
        glowSoft: 'rgba(245, 158, 11, 0.22)',
        border: 'rgba(252, 211, 77, 0.42)',
        modalBg: '#261c10',
        headerBg: '#342617',
        glowGradient: 'radial-gradient(ellipse at 50% 0%, rgba(245, 158, 11, 0.32) 0%, transparent 70%)',
        badgeBg: 'rgba(245, 158, 11, 0.22)',
      },
      serene: {
