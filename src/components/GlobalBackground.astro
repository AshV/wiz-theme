---
/**
 * GlobalBackground — Atmospheric Canvas Architecture.
 *
 * Combines:
 * 1. Living Fluid Gradient Mesh: Smooth, morphing multi-stop radial gradient pools
 *    that breathe and drift continuously with organic fluidity.
 * 2. 12 Pure Elegant Line Art Engines: Sacred geometry, celestial astrolabes, topographic
 *    waves, harmonic Lissajous orbits, golden spirals, aurora ribbons, torus knots,
 *    sacred lotus roses, hyperspace tunnels, terrain grids, and Metatron lattices.
 * 3. 18 Vibrant Aesthetic Color Palettes: Multi-chromatic gradients with intelligent
 *    last-2 exclusion to maximize randomness and eliminate visual monotony.
 * 4. Distraction-Free: Zero harsh star dots or flashing sparks, ensuring pure quote legibility.
 */
---
<div
  data-astro-transition-persist="global-bg"
  id="global-bg"
  class="fixed inset-0 z-0 overflow-hidden pointer-events-none select-none"
>
  <!-- Dynamic Generative Visual Canvas -->
  <canvas id="ambient-canvas" class="absolute inset-0 w-full h-full"></canvas>

  <!-- Atmospheric Light Bloom Overlays -->
  <div
    id="mood-glow-1"
    class="absolute -top-[15%] -left-[10%] w-[75vw] h-[75vw] rounded-full blur-[120px] opacity-60 transition-colors duration-1000 ease-out pointer-events-none"
  ></div>
  <div
    id="mood-glow-2"
    class="absolute -bottom-[15%] -right-[10%] w-[80vw] h-[80vw] rounded-full blur-[130px] opacity-55 transition-colors duration-1000 ease-out pointer-events-none"
  ></div>
  <div
    id="mood-glow-center"
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[94vw] max-w-[850px] h-[55vh] max-h-[600px] rounded-[50%] blur-[110px] opacity-50 transition-colors duration-1000 ease-out pointer-events-none"
  ></div>

  <!-- Lighter Atmospheric Vignette (Guarantees Quote Legibility with Uplifting Ambiance) -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/45 via-black/10 to-black/25 pointer-events-none transition-opacity duration-700"></div>
</div>

<script>
  (function() {
    let canvas = document.getElementById('ambient-canvas') as HTMLCanvasElement | null;
    let ctx = canvas ? canvas.getContext('2d') : null;

    function getCanvasAndContext() {
      if (!canvas || !canvas.isConnected) {
        canvas = document.getElementById('ambient-canvas') as HTMLCanvasElement | null;
        if (canvas) {
          ctx = canvas.getContext('2d');
        }
      }
      return { canvas, ctx };
    }

    let width = 0;
    let height = 0;
    let dpr = 1;
    let animId: number | null = null;
    let isVisible = true;
    let time = 0;

    // ── 18 Curated, Breathtaking Color Palettes (Rich, Luminous, Ethereal) ──
